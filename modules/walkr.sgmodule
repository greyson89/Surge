#!name=Walkr v9
#!desc=參數請在管理介面 https://walkr.mysurge.com/ 設定,其他功能請參考各腳本詳細資訊 20261124
#!category=Walkr
#!system=ios 

[Script]

[Walkr]共駕與傳說資料不使用快取 = type=http-request,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/(pilots|fleets\/current)\?,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-bridge-no-cache.js

[Walkr]修改共駕能量 = type=http-response,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/pilots\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-bridge-energy.js

[Walkr]取得修改後共駕能量 = type=http-response,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/pilots\/consume,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-bridge-get-energy.js

[Walkr]修改轉換給共駕之能量 = type=http-request,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/pilots\/convert,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-covert-energy.js

[Walkr]重登修改帳號數據 = type=http-response,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/players\/[\d]+,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-player-data-modify.js

[Walkr]修改走路步數 = type=http-request,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/warehouse\/u\/activity,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-pedometer-modify.js

[Walkr]取得未持有的特殊飛船 = type=http-response,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/warehouse\/d\/spaceship,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-get-spaceship.js

[Walkr]EPIC獎勵提升 = type=http-response,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/fleets\/\d+\/finish,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-change-epic-reward.js

[Walkr]擷取實驗室資訊 = type=http-request,pattern=https:\/\/production\.sw\.(fourdesireplay|fourdesire)\.(io|com)\/api\/v2\/(labs\/current|comments\?),script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-lab-capture.js

[Walkr]實驗室自動贊助 = type=cron,cronexp="*/30 * * * *",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-lab-auto-donate.js

[Walkr]傳說自動繳納 = type=cron,cronexp="*/10 * * * *",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-epic-auto-contribute.js

[Walkr]傳說立即繳納 = script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-epic-auto-contribute.js,argument=run,timeout=60

[Walkr]傳說單次測試 = script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-epic-auto-contribute.js,argument=test,timeout=30

[Walkr]管理介面 = type=http-request,pattern=^https?:\/\/walkr\.mysurge\.com\/?$,requires-body=0,timeout=10,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-config-page.js

[Walkr]管理介面API = type=http-request,pattern=^https?:\/\/walkr\.mysurge\.com\/api\/(read|write|status|reset),requires-body=1,max-size=0,timeout=10,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-config-api.js

[Walkr]管理介面傳說操作 = type=http-request,pattern=^https?:\/\/walkr\.mysurge\.com\/api\/epic\/,timeout=60,script-path=https://raw.githubusercontent.com/greyson89/Surge/master/scripts/walkr-epic-auto-contribute.js


[MITM]
hostname = %APPEND% *.fourdesireplay.io, *.fourdesire.com, *.fourdesireplay.com, *.fourdesire.io, walkr.mysurge.com
